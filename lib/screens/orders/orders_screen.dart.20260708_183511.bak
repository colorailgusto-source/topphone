            else
              const Text('Nessun dettaglio disponibile',
                  style: TextStyle(color: AppTheme.grey)),

            const Divider(height: 24),
            if (order.tipoConsegna == 'spedizione') ...[
              Builder(builder: (context) {
                final sommaProdotti = order.righe?.fold<double>(
                        0.0,
                        (sum, r) =>
                            sum +
                            ((r['prezzo'] as num?)?.toDouble() ?? 0) *
                                ((r['quantita'] as num?)?.toDouble() ?? 1)) ??
                    0.0;
                final speseSpedizione = order.totale - sommaProdotti;
                return Column(children: [
                  Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        const Text('Prodotti:',
                            style:
