                                          .withValues(alpha: 0.1),
                                      child: const Icon(Icons.phone_android,
                                          color: AppTheme.primary, size: 20)))
                              : Container(
                                  width: 50,
                                  height: 50,
                                  color:
                                      AppTheme.primary.withValues(alpha: 0.1),
                                  child: const Icon(Icons.phone_android,
                                      color: AppTheme.primary, size: 20)),
                        ),
                        const SizedBox(width: 12),
                        Expanded(
