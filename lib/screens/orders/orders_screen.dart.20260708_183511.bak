                                color: Colors.red,
                                fontSize: 12,
                              ),
                            ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
            ],
const SizedBox(height: 24),
            const Text('PRODOTTI',
                style: TextStyle(
                    color: AppTheme.grey,
                    fontSize: 12,
                    fontWeight: FontWeight.bold,
                    fontFamily: 'Poppins')),
            const SizedBox(height: 8),
            if (order.righe != null && order.righe!.isNotEmpty)
